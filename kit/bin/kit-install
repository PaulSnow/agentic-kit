#!/usr/bin/env python3
"""Install the pieces named in kit/manifest.txt into another repository.

Copies each manifest path verbatim to the same repo-relative path under the
target (for a directory, the files `git ls-files` lists under it; any
uncommitted change to a manifest path refuses the install), creates each "empty DIR" entry as DIR/.gitkeep (a ledger that starts
empty, never the template's own entries), records the upstream commit it came from in the target's
`.kit-version`, and lists the references in the installed files that do not
resolve in the target: Markdown links, resolved against the file, and paths
named in prose, resolved against the repository root. A prose path counts only
when it contains "/" or "." and names a file this checkout tracks. Those are the cross-references to
parts of the starter that were not adopted; the adopting repo decides whether
to rewrite or drop them.

After a real install (not --dry-run) it runs the target's `bin/lessons
validate` and `bin/check-catalogs`, when present, and prints their outcome;
a failing check does not fail the install.

An existing target file with different bytes is never overwritten unless
--force is given; the refusal names it. --dry-run reports without writing.

Every destination must stay inside TARGET: a manifest entry that is absolute or
contains ".." is refused, and so is a destination that is itself a symlink or
sits under a symlinked directory inside TARGET. A source that is a symlink is
copied as a symlink, never followed.

Usage: kit/bin/kit-install [--dry-run] [--force] TARGET
Exit: 0 installed (or would install); 1 refused; 2 usage.
"""

from __future__ import annotations

import argparse
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
MANIFEST = ROOT / "kit" / "manifest.txt"
LINK = re.compile(r"\]\(([^)#\s]+)")
TOKEN = re.compile(r"[\w./-]+")


class Refusal(Exception):
    pass


def relative_entry(entry: str) -> str:
    """A manifest entry, refused when it could name a path outside the tree."""
    path = Path(entry)
    if not entry or path.is_absolute() or ".." in path.parts:
        raise Refusal(f"manifest entry is absolute or contains '..': {entry}")
    return entry


def destination(target: Path, rel: str) -> Path:
    """TARGET/REL, refused when it or a directory above it inside TARGET is a
    symlink, or when it resolves outside TARGET."""
    dst = target / rel
    current = target
    for part in Path(rel).parts:
        current = current / part
        if current.is_symlink():
            raise Refusal(f"destination is or lies under a symlink: "
                          f"{current.relative_to(target).as_posix()}")
    if not dst.resolve().is_relative_to(target):
        raise Refusal(f"destination resolves outside the target: {rel}")
    return dst


def same(src: Path, dst: Path) -> bool:
    if src.is_symlink() or dst.is_symlink():
        return src.is_symlink() and dst.is_symlink() and src.readlink() == dst.readlink()
    return dst.read_bytes() == src.read_bytes()


def tracked_files() -> set[str]:
    out = subprocess.run(["git", "-C", str(ROOT), "ls-files"],
                         capture_output=True, text=True, check=True)
    return set(out.stdout.splitlines())


def manifest_entries(tracked: set[str]) -> tuple[list[Path], list[str]]:
    """The tracked files to copy, and the directories to create empty.

    A directory contributes only what `git ls-files` lists under it, and any
    uncommitted change to a manifest path refuses the install, so what is
    installed is exactly what the recorded commit holds."""
    files, empty, sources = [], [], []
    for line in MANIFEST.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("empty "):
            empty.append(relative_entry(line.removeprefix("empty ").strip().rstrip("/")))
            continue
        entry = relative_entry(line).rstrip("/")
        members = sorted(path for path in tracked if path.startswith(entry + "/"))
        if entry in tracked:
            files.append(ROOT / entry)
        elif members:
            files += [ROOT / path for path in members]
        elif (ROOT / entry).exists() or (ROOT / entry).is_symlink():
            raise Refusal(f"manifest names a path git does not track: {entry}")
        else:
            raise Refusal(f"manifest names a missing path: {entry}")
        sources.append(entry)
    dirty = subprocess.run(
        ["git", "-C", str(ROOT), "status", "--porcelain", "--untracked-files=no",
         "--", *sources],
        capture_output=True, text=True, check=True,
    ).stdout.splitlines()
    if dirty:
        raise Refusal("manifest paths have uncommitted changes:\n"
                      + "\n".join(f"  {line[3:]}" for line in dirty))
    return files, empty


def unresolved(src: Path, target: Path, installed: set[Path], tracked: set[str]) -> set[str]:
    rel = src.relative_to(ROOT)
    text = src.read_text(encoding="utf-8")
    missing = set()
    for link in LINK.findall(text):
        if "://" in link or link.startswith("mailto:"):
            continue
        if not (target / rel.parent / link).resolve().exists() and \
                (ROOT / rel.parent / link).resolve() not in installed:
            missing.add(link)
    for token in TOKEN.findall(text):
        path = token.rstrip(".")
        if ("/" in path or "." in path) and path in tracked and \
                not (target / path).exists() and ROOT / path not in installed:
            missing.add(path)
    return missing


def upstream_commit() -> str:
    """The upstream commit the installed files came from: where this checkout
    last merged upstream/master. Without that ref, the checkout's own HEAD,
    marked as such."""
    def git(*arguments: str) -> subprocess.CompletedProcess[str]:
        return subprocess.run(["git", "-C", str(ROOT), *arguments],
                              capture_output=True, text=True)
    base = git("merge-base", "HEAD", "upstream/master")
    if base.returncode == 0:
        return git("log", "-1", "--format=%H %cs", base.stdout.strip()).stdout.strip()
    head = git("log", "-1", "--format=%H %cs").stdout.strip()
    return (f"{head} (no upstream/master in the kit checkout; "
            "this is its own HEAD, not an upstream commit)")


POST_CHECKS = (("bin/lessons", "validate"), ("bin/check-catalogs",))


def post_checks(target: Path) -> None:
    """Run the target's own ledger checks and print their outcome. They report;
    they never fail the install. check-catalogs expects the starter's CLAUDE.md
    zone markers and plan/INDEX.md, so a repository without them fails it."""
    print("\nchecks in the target (reported, not enforced):")
    for command in POST_CHECKS:
        name = " ".join(command)
        if not (target / command[0]).is_file():
            print(f"  {name}: not present")
            continue
        try:
            result = subprocess.run([str(target / command[0]), *command[1:]], cwd=target,
                                    capture_output=True, text=True, timeout=300)
        except (OSError, subprocess.TimeoutExpired) as exc:
            print(f"  {name}: could not run ({type(exc).__name__})")
            continue
        outcome = "passed" if result.returncode == 0 else f"failed (exit {result.returncode})"
        print(f"  {name}: {outcome}")
        for line in (result.stdout + result.stderr).splitlines()[-20:]:
            print(f"    {line}")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("target", type=Path)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--force", action="store_true")
    a = ap.parse_args()
    target = a.target.resolve()
    if not (target / ".git").exists():
        print(f"kit-install: {target} is not a git repository", file=sys.stderr)
        return 2

    tracked = tracked_files()
    try:
        files, empty = manifest_entries(tracked)
        destinations = {src: destination(target, src.relative_to(ROOT).as_posix())
                        for src in files}
        keeps = [destination(target, f"{directory}/.gitkeep") for directory in empty]
        version_file = destination(target, ".kit-version")
    except Refusal as exc:
        print(f"kit-install: refusing; {exc}", file=sys.stderr)
        return 1
    conflicts = []
    for src, dst in destinations.items():
        if dst.exists() and not same(src, dst):
            conflicts.append(dst.relative_to(target).as_posix())
    if conflicts and not a.force:
        print("kit-install: refusing; these differ in the target (use --force):", file=sys.stderr)
        for c in conflicts:
            print(f"  {c}", file=sys.stderr)
        return 1

    installed = set(files)
    dangling = []
    for src in files:
        rel = src.relative_to(ROOT)
        dst = destinations[src]
        print(f"{'would install' if a.dry_run else 'install'} {rel.as_posix()}")
        if not a.dry_run:
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst, follow_symlinks=False)
        if src.suffix == ".md" and not src.is_symlink():
            dangling += [f"{rel.as_posix()} -> {ref}"
                         for ref in unresolved(src, target, installed, tracked)]

    for directory, keep in zip(empty, keeps):
        print(f"{'would create' if a.dry_run else 'create'} {directory}/ (empty)")
        if not a.dry_run and not keep.exists():
            keep.parent.mkdir(parents=True, exist_ok=True)
            keep.write_text("", encoding="utf-8")

    stamp = f"agentic-kit {upstream_commit()}\n"
    if not a.dry_run:
        version_file.write_text(stamp, encoding="utf-8")
    print(f"{'would record' if a.dry_run else 'recorded'} .kit-version: {stamp.strip()}")
    dangling = sorted(set(dangling))
    if dangling:
        print(f"\n{len(dangling)} references do not resolve in the target:")
        for d in dangling:
            print(f"  {d}")
    if not a.dry_run:
        post_checks(target)
    return 0


if __name__ == "__main__":
    sys.exit(main())
