#!/usr/bin/env python3
"""Install the pieces named in kit/manifest.txt into another repository.

Copies each manifest path verbatim to the same repo-relative path under the
target, records the upstream commit it came from in the target's
`.kit-version`, and lists the references in the installed files that do not
resolve in the target: Markdown links, resolved against the file, and paths
named in prose, resolved against the repository root. A prose path counts only
when it contains "/" or "." and names a file this checkout tracks. Those are the cross-references to
parts of the starter that were not adopted; the adopting repo decides whether
to rewrite or drop them.

An existing target file with different bytes is never overwritten unless
--force is given; the refusal names it. --dry-run reports without writing.

Usage: bin/kit-install [--dry-run] [--force] TARGET
Exit: 0 installed (or would install); 1 refused; 2 usage.
"""

from __future__ import annotations

import argparse
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / "kit" / "manifest.txt"
LINK = re.compile(r"\]\(([^)#\s]+)")
TOKEN = re.compile(r"[\w./-]+")


def manifest_files() -> list[Path]:
    files = []
    for line in MANIFEST.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        src = ROOT / line
        if src.is_dir():
            files += sorted(p for p in src.rglob("*") if p.is_file())
        elif src.is_file():
            files.append(src)
        else:
            sys.exit(f"kit-install: manifest names a missing path: {line}")
    return files


def tracked_files() -> set[str]:
    out = subprocess.run(["git", "-C", str(ROOT), "ls-files"],
                         capture_output=True, text=True, check=True)
    return set(out.stdout.splitlines())


def unresolved(src: Path, target: Path, installed: set[Path], tracked: set[str]) -> set[str]:
    rel = src.relative_to(ROOT)
    text = src.read_text(encoding="utf-8")
    missing = set()
    for link in LINK.findall(text):
        if "://" in link or link.startswith("mailto:"):
            continue
        if not (target / rel.parent / link).resolve().exists() and \
                (ROOT / rel.parent / link).resolve() not in installed:
            missing.add(link)
    for token in TOKEN.findall(text):
        path = token.rstrip(".")
        if ("/" in path or "." in path) and path in tracked and \
                not (target / path).exists() and ROOT / path not in installed:
            missing.add(path)
    return missing


def upstream_commit() -> str:
    out = subprocess.run(
        ["git", "-C", str(ROOT), "log", "-1", "--format=%H %cs", "upstream/master"],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        out = subprocess.run(["git", "-C", str(ROOT), "log", "-1", "--format=%H %cs"],
                             capture_output=True, text=True, check=True)
    return out.stdout.strip()


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("target", type=Path)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--force", action="store_true")
    a = ap.parse_args()
    target = a.target.resolve()
    if not (target / ".git").exists():
        print(f"kit-install: {target} is not a git repository", file=sys.stderr)
        return 2

    files = manifest_files()
    conflicts = []
    for src in files:
        dst = target / src.relative_to(ROOT)
        if dst.exists() and dst.read_bytes() != src.read_bytes():
            conflicts.append(dst.relative_to(target).as_posix())
    if conflicts and not a.force:
        print("kit-install: refusing; these differ in the target (use --force):", file=sys.stderr)
        for c in conflicts:
            print(f"  {c}", file=sys.stderr)
        return 1

    installed = set(files)
    tracked = tracked_files()
    dangling = []
    for src in files:
        rel = src.relative_to(ROOT)
        dst = target / rel
        print(f"{'would install' if a.dry_run else 'install'} {rel.as_posix()}")
        if not a.dry_run:
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
        if src.suffix == ".md":
            dangling += [f"{rel.as_posix()} -> {ref}"
                         for ref in unresolved(src, target, installed, tracked)]

    stamp = f"agentic-kit {upstream_commit()}\n"
    if not a.dry_run:
        (target / ".kit-version").write_text(stamp, encoding="utf-8")
    print(f"{'would record' if a.dry_run else 'recorded'} .kit-version: {stamp.strip()}")
    dangling = sorted(set(dangling))
    if dangling:
        print(f"\n{len(dangling)} references do not resolve in the target:")
        for d in dangling:
            print(f"  {d}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
